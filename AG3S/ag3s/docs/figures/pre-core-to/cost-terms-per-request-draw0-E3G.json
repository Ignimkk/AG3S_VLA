{
 "source": "/mnt/dev/AG3S_VLA-storage/results/development/20261025T191319+0900_35b909cf096a_cc215238f581/verify/AG3S-PRE-CORE-TO/COST/cost_summary.json",
 "definitions": {
  "terms": "problem.objective terms evaluated separately with the server's weights: track = w_track * sum_k decay^k sum_j scale_j (Q-R)^2 (scale = recorded to.metrics.joint_track_scale, else 1); smooth = w_smooth * sum (second difference of Q)^2; continuity = w_continuity * sum over the first min(8, overlap) rows (Q - previous executed chunk aligned at n_exec)^2; deflection_rate = w_deflection_rate * (sum ||D_{k+1}-D_k||^2 + ||D_0 - d_hist||^2), D = Q - R, d_hist = last applied row - previous reference at that row (0 when the deflection-rate gate is off for the chunk); violation_price = w_slack * merit violation, taken from the server record (to.metrics.initial_violation_m for (a), candidates[returned_index].violation_m for (b)); the offline reconstruction (ta_offline scene) only when not recorded (returned = projection) and as a separate cross-check (gate open: window (rows 0-7) + tail (rows 8-15) worst violation; gate closed: window optimizer, rows 0-7 full violation). Changed 2026-10-27 23:10 KST after the first aggregate: the reconstruction differed from the record in some latched / held requests (e.g. +10.0 mm = obstacle_margin on rows the server exempts); before the change the reconstruction was used for every request; grasp_goal = grasp_anchor.anchor_cost with the recorded goal_m, goal_rows, w_goal (w_tcp path term when > 0). merit = sum.",
  "a_b": "(a) = reference_chunk as the trajectory (R = Q -> track and deflection inner terms 0), (b) = recorded refined_chunk; horizon = 8 rows when the recorded look-ahead gate is closed (window optimizer), 16 when open",
  "modified_request": "max |refined - reference| over left-arm joints rows 0-7 > 0.01 deg (raw value reported)",
  "close": "t_close = first control step with executed_actions[:, 7] (left gripper) < 0.9 (GIK definition); close request = last request whose client control step <= t_close; 'before the close' = requests 0 .. close_request-1",
  "dominant_term": "per modified request, the term with the largest |b - a|; 'decreasing term' = the term with the most negative b - a; both also among the cost terms only (violation price excluded)",
  "merit_crosscheck": "|merit(a) - recorded initial_merit| (initial iterate = reference: warm_start_lookahead off, window horizon 8 = execution length, no stay start) and |merit(b) - recorded merit of the returned candidate| (returned = accepted); reported as max abs and max rel",
  "merit_crosscheck_tolerance": "mismatch = |mine - recorded| > 1e-4 * max(|recorded|, 1e-3); set 2026-10-27 23:00 KST after seeing the first 3 runs (max rel 1.9e-5 outside 5 post-close held requests of one run)",
  "palm": "URDF link ee_left origin by the snapshot's robot FK, refined vs reference, rows 0-7, mm",
  "apple": "MuJoCo body 'apple' xpos at the request's client step qpos (scene_truth with the run's obstacle config); target centroid = recorded target_centroid",
  "fixed_at": "2026-10-27 22:58-23:10 KST, before the aggregate was computed (first raw file looked at only for the merit cross-check)"
