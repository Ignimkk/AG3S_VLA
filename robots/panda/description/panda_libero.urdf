<?xml version="1.0" ?>
<!--
  Panda as LIBERO simulates it (robosuite 1.4 MountedPanda + PandaGripper), kinematics only.
  AG3S benchmark adapter asset (SL2, 2026-10-12). Read by AG3S/adapters/panda/model.py.

  Provenance: third_party/curobo/curobo/content/assets/robot/franka_description/franka_panda.urdf
  (cuRobo submodule 78fd485f, not modified). Joint origins, axes and limits of panda_joint1..7 are
  copied verbatim. Measured against the LIBERO MuJoCo model (libero_spatial task 0,
  benchmark/adapters/libero_panda/robot_geometry.py fk), the cuRobo URDF gives link0..link7
  exactly (0.000 mm, 0.0000 deg) but the hand and fingers differ, because robosuite assembles them
  with its own offsets. Corrected here to the robosuite values (meshes are identical in their link
  frames, so these are frame offsets, not shape differences):

    joint                cuRobo URDF                      this file (= robosuite)
    panda_joint8         xyz 0 0 0.107                    xyz 0 0 0.1065          robot.xml right_hand pos
    panda_hand_joint     rpy 0 0 -0.785398163397          rpy 0 0 -0.7858907877735346
                                                          (= 2 atan2(-0.383, 0.924), robot.xml right_hand quat "0.924 0 0 -0.383")
    panda_finger_joint1  xyz 0 0 0.0584                   xyz 0 0 0.0524          panda_gripper.xml leftfinger pos
    panda_finger_joint2  xyz 0 0 0.0584                   xyz 0 0 0.0524          panda_gripper.xml rightfinger pos
    (cuRobo error before correction: hand 0.500 mm / 0.028 deg, fingers 6.500 mm along hand z)

  Dropped: base_link (root is panda_link0 = MuJoCo robot0_base = robot0_link0, same pose), ee_link and
  right_gripper (cuRobo helper frames that do not exist in robosuite), meshes and inertials
  (AG3S needs kinematics; geometry comes from franka.yml spheres + robots/panda/description/
  libero_panda_self_filter_cover.json).
  Added (fixed, robosuite frames): panda_grip_site = gripper0_grip_site (OSC_POSE control point,
  gripper0_right_gripper rotated -90 deg about hand z, +0.097 m), panda_eye_in_hand = MuJoCo camera
  robot0_eye_in_hand with OpenCV axes (+x right, +y down, +z forward; T_base_cam of the left_wrist wire camera).

  Joint map (MuJoCo qpos = adapter robot_state order -> this URDF):
    robot0_joint1..7         -> panda_joint1..7       same sign
    gripper0_finger_joint1   -> panda_finger_joint1   same sign   (range [0, 0.04], axis +y)
    gripper0_finger_joint2   -> panda_finger_joint2   NEGATED     (MuJoCo range [-0.04, 0] about +y, URDF [0, 0.04] about -y)
-->
<robot name="panda_libero">
  <link name="panda_link0"/>
  <link name="panda_link1"/>
  <joint name="panda_joint1" type="revolute">
    <parent link="panda_link0"/>
    <child link="panda_link1"/>
    <origin rpy="0 0 0" xyz="0 0 0.333"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" lower="-2.8973" upper="2.8973" velocity="2.1750"/>
  </joint>
  <link name="panda_link2"/>
  <joint name="panda_joint2" type="revolute">
    <parent link="panda_link1"/>
    <child link="panda_link2"/>
    <origin rpy="-1.57079632679 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" lower="-1.7628" upper="1.7628" velocity="2.1750"/>
  </joint>
  <link name="panda_link3"/>
  <joint name="panda_joint3" type="revolute">
    <parent link="panda_link2"/>
    <child link="panda_link3"/>
    <origin rpy="1.57079632679 0 0" xyz="0 -0.316 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" lower="-2.8973" upper="2.8973" velocity="2.1750"/>
  </joint>
  <link name="panda_link4"/>
  <joint name="panda_joint4" type="revolute">
    <parent link="panda_link3"/>
    <child link="panda_link4"/>
    <origin rpy="1.57079632679 0 0" xyz="0.0825 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="87" lower="-3.0718" upper="-0.0698" velocity="2.1750"/>
  </joint>
  <link name="panda_link5"/>
  <joint name="panda_joint5" type="revolute">
    <parent link="panda_link4"/>
    <child link="panda_link5"/>
    <origin rpy="-1.57079632679 0 0" xyz="-0.0825 0.384 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="12" lower="-2.8973" upper="2.8973" velocity="2.6100"/>
  </joint>
  <link name="panda_link6"/>
  <joint name="panda_joint6" type="revolute">
    <parent link="panda_link5"/>
    <child link="panda_link6"/>
    <origin rpy="1.57079632679 0 0" xyz="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="12" lower="-0.0175" upper="3.7525" velocity="2.6100"/>
  </joint>
  <link name="panda_link7"/>
  <joint name="panda_joint7" type="revolute">
    <parent link="panda_link6"/>
    <child link="panda_link7"/>
    <origin rpy="1.57079632679 0 0" xyz="0.088 0 0"/>
    <axis xyz="0 0 1"/>
    <limit effort="12" lower="-2.8973" upper="2.8973" velocity="2.6100"/>
  </joint>
  <link name="panda_link8"/>
  <joint name="panda_joint8" type="fixed">
    <parent link="panda_link7"/>
    <child link="panda_link8"/>
    <origin rpy="0 0 0" xyz="0 0 0.1065"/>
  </joint>
  <link name="panda_hand"/>
  <joint name="panda_hand_joint" type="fixed">
    <parent link="panda_link8"/>
    <child link="panda_hand"/>
    <origin rpy="0 0 -0.7858907877735346" xyz="0 0 0"/>
  </joint>
  <link name="panda_leftfinger"/>
  <link name="panda_rightfinger"/>
  <joint name="panda_finger_joint1" type="prismatic">
    <parent link="panda_hand"/>
    <child link="panda_leftfinger"/>
    <origin rpy="0 0 0" xyz="0 0 0.0524"/>
    <axis xyz="0 1 0"/>
    <limit effort="20" lower="0.0" upper="0.04" velocity="0.2"/>
  </joint>
  <joint name="panda_finger_joint2" type="prismatic">
    <parent link="panda_hand"/>
    <child link="panda_rightfinger"/>
    <origin rpy="0 0 0" xyz="0 0 0.0524"/>
    <axis xyz="0 -1 0"/>
    <limit effort="20" lower="0.0" upper="0.04" velocity="0.2"/>
  </joint>
  <link name="panda_grip_site"/>
  <joint name="panda_grip_site_joint" type="fixed">
    <parent link="panda_hand"/>
    <child link="panda_grip_site"/>
    <origin rpy="0 0 -1.5707963267948966" xyz="0 0 0.097"/>
  </joint>
  <link name="panda_eye_in_hand"/>
  <joint name="panda_eye_in_hand_joint" type="fixed">
    <parent link="panda_hand"/>
    <child link="panda_eye_in_hand"/>
    <origin rpy="0 0 1.5707963267948966" xyz="0.05 0 0"/>
  </joint>
</robot>
