<mujocoinclude>
  <!-- Static, table-mounted obstacles for block and fruit pick-and-place evaluation.

       These are deliberately composed props rather than bare debug boxes.
       Every visual geom is black (rgba 0.02 0.02 0.02 1) by default (T42-2);
       an obstacle entry of a profile can recolour its slot with "rgba"
       (PickPlaceObstacleManager writes model.geom_rgba of that slot's visual
       geoms only; collision geoms are never touched).  Each complete prop is
       a mocap body, so a profile can place it without adding qpos, joints, or
       actuators.  Collision geoms are hidden in group 3; visible geoms are
       non-colliding and use group 2 like the rest of the scene. -->

  <body name="pick_obstacle_bollard_0" mocap="true" pos="8 8 2">
    <geom class="prop_collision" name="pick_obstacle_bollard_0_collision"
          type="cylinder" size="0.027 0.1385" pos="0 0 0.1485"/>
    <geom class="prop_collision" name="pick_obstacle_bollard_0_collision_foot"
          type="cylinder" size="0.045 0.010" pos="0 0 0.010"/>
    <geom class="prop_visual" name="pick_obstacle_bollard_0_foot"
          type="cylinder" size="0.045 0.010" pos="0 0 0.010"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_bollard_0_post"
          type="cylinder" size="0.025 0.125" pos="0 0 0.135"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_bollard_0_band_low"
          type="cylinder" size="0.026 0.014" pos="0 0 0.080"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_bollard_0_band_high"
          type="cylinder" size="0.026 0.014" pos="0 0 0.190"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_bollard_0_cap"
          type="sphere" size="0.027" pos="0 0 0.260"
          rgba="0.02 0.02 0.02 1"/>
  </body>

  <body name="pick_obstacle_bollard_1" mocap="true" pos="9 8 2">
    <geom class="prop_collision" name="pick_obstacle_bollard_1_collision"
          type="cylinder" size="0.027 0.1385" pos="0 0 0.1485"/>
    <geom class="prop_collision" name="pick_obstacle_bollard_1_collision_foot"
          type="cylinder" size="0.045 0.010" pos="0 0 0.010"/>
    <geom class="prop_visual" name="pick_obstacle_bollard_1_foot"
          type="cylinder" size="0.045 0.010" pos="0 0 0.010"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_bollard_1_post"
