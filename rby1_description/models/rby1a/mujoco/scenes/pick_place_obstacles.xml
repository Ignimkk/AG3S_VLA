  <body name="pick_obstacle_divider_0" mocap="true" pos="10 8 2">
    <geom class="prop_collision" name="pick_obstacle_divider_0_collision"
          type="box" size="0.104 0.018 0.040" pos="0 0 0.040"/>
    <geom class="prop_collision" name="pick_obstacle_divider_0_collision_foot_left"
          type="box" size="0.030 0.040 0.006" pos="-0.085 0 0.006"/>
    <geom class="prop_collision" name="pick_obstacle_divider_0_collision_foot_right"
