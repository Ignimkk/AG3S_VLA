    <geom class="prop_visual" name="pick_obstacle_divider_0_rail_bottom"
          type="box" size="0.100 0.018 0.007" pos="0 0 0.007"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_divider_0_foot_left"
          type="box" size="0.030 0.040 0.006" pos="-0.085 0 0.006"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_divider_0_foot_right"
          type="box" size="0.030 0.040 0.006" pos="0.085 0 0.006"
