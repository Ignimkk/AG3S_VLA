  <body name="pick_obstacle_fence_0_leg_left" mocap="true" pos="12.910 8 2.035">
    <inertial pos="0 0 0" mass="0.1" diaginertia="1e-4 1e-4 1e-4"/>
    <geom class="prop_collision" name="pick_obstacle_fence_0_collision_leg_left"
          type="cylinder" size="0.007 0.035"/>
    <geom class="prop_visual" name="pick_obstacle_fence_0_leg_left"
