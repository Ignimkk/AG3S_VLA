  <!-- hurdle_0 (T40 E): a horizontal bar on two posts that the carried fruit
       has to pass over.  Capsules and cylinders only - MuJoCo 3.11
       mj_geomDistance is wrong for some box pairs (T40 A), and the obstacle
       stop / reset clearance checks call it.

       Adjustable bar height without touching the model: the prop is two
       mocap bodies that telescope.
         pick_obstacle_hurdle_0      at the table surface: two feet and two
                                     fixed sleeves (z 0.012 .. 0.180)
         pick_obstacle_hurdle_0_bar  at the bar centre: the bar and two
                                     sliding posts that reach 0.150 m down
                                     into the sleeves
       PickPlaceObstacleManager puts the second body at position + bar_height
       (bar centre above the table, 0.20 .. 0.32 m), same yaw.  Over that range
       the sliding post bottom (bar_height - 0.150) stays inside the sleeve
       (0.012 .. 0.180), so the posts always look and collide as continuous.
       Mocap bodies are welded to the world, so the two bodies never collide
       with each other or with the table.
       Bar along local x: capsule r 0.012, fromto x -0.12 .. 0.12 (0.264 m end
       to end).  Collision geoms have exactly the visual sizes. -->
  <body name="pick_obstacle_hurdle_0" mocap="true" pos="11 8 2">
    <geom class="prop_collision" name="pick_obstacle_hurdle_0_collision_foot_left"
          type="cylinder" size="0.035 0.006" pos="-0.12 0 0.006"/>
    <geom class="prop_collision" name="pick_obstacle_hurdle_0_collision_foot_right"
          type="cylinder" size="0.035 0.006" pos="0.12 0 0.006"/>
    <geom class="prop_collision" name="pick_obstacle_hurdle_0_collision_sleeve_left"
          type="cylinder" size="0.014 0.084" pos="-0.12 0 0.096"/>
    <geom class="prop_collision" name="pick_obstacle_hurdle_0_collision_sleeve_right"
          type="cylinder" size="0.014 0.084" pos="0.12 0 0.096"/>
    <geom class="prop_visual" name="pick_obstacle_hurdle_0_foot_left"
          type="cylinder" size="0.035 0.006" pos="-0.12 0 0.006"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_hurdle_0_foot_right"
          type="cylinder" size="0.035 0.006" pos="0.12 0 0.006"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_hurdle_0_sleeve_left"
          type="cylinder" size="0.014 0.084" pos="-0.12 0 0.096"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_hurdle_0_sleeve_right"
          type="cylinder" size="0.014 0.084" pos="0.12 0 0.096"
          rgba="0.02 0.02 0.02 1"/>
  </body>

  <body name="pick_obstacle_hurdle_0_bar" mocap="true" pos="11 8 2.26">
    <geom class="prop_collision" name="pick_obstacle_hurdle_0_collision_bar"
          type="capsule" size="0.012" fromto="-0.12 0 0 0.12 0 0"/>
    <geom class="prop_collision" name="pick_obstacle_hurdle_0_collision_post_left"
          type="cylinder" size="0.010 0.075" pos="-0.12 0 -0.075"/>
    <geom class="prop_collision" name="pick_obstacle_hurdle_0_collision_post_right"
          type="cylinder" size="0.010 0.075" pos="0.12 0 -0.075"/>
    <geom class="prop_visual" name="pick_obstacle_hurdle_0_bar"
          type="capsule" size="0.012" fromto="-0.12 0 0 0.12 0 0"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_hurdle_0_bar_band_left"
          type="cylinder" size="0.0125 0.015" pos="-0.05 0 0" zaxis="1 0 0"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_hurdle_0_bar_band_right"
          type="cylinder" size="0.0125 0.015" pos="0.05 0 0" zaxis="1 0 0"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_hurdle_0_post_left"
          type="cylinder" size="0.010 0.075" pos="-0.12 0 -0.075"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_hurdle_0_post_right"
          type="cylinder" size="0.010 0.075" pos="0.12 0 -0.075"
          rgba="0.02 0.02 0.02 1"/>
  </body>

  <!-- T42-2: resizable black slots, capsules and cylinders only (no box:
       MuJoCo 3.11 box distances are wrong, T40 A; every obstacle distance goes
       through PickPlaceObstacleManager.pair_distance = mj_geomDistance checked by
       convex_distance, T40 H).

       One collision geom per mocap body, centred on the body origin, plus a
       visual twin of the same size.  Each body has an explicit <inertial>, so
       its inertial frame is the body frame and does not depend on the geom
       size.  The manager sets the sizes from the config at activate() and
       updates every compiled quantity that depends on them (geom_size,
       geom_rbound, geom_aabb and the body's one-node BVH, bvh_aabb); park_all()
       restores the compiled sizes below, which are the config defaults.
       tests/sim/test_t42_obstacles.py pins this against a model compiled with
       the same sizes, array for array.

         pick phase
           post_0        vertical cylinder beside the fruit: height, radius
           fence_0       low capsule rail on two short cylinder legs:
                         bar_height, length, radius (rail); legs r 7 mm
           overbar_0     capsule bar above the fruit on two cylinder legs:
                         bar_height, length, radius (bar); legs r 12 mm
         place phase
           hurdle_0      (above, T40 E)
           crate_post_0  vertical cylinder beside the crate rim: height, radius

       The bar axis is the body's local x (zaxis="1 0 0"), so yaw = 0 puts it
       along world x; legs stand at local x = -length/2, +length/2. -->

  <body name="pick_obstacle_post_0" mocap="true" pos="12 8 2.110">
    <inertial pos="0 0 0" mass="0.1" diaginertia="1e-4 1e-4 1e-4"/>
    <geom class="prop_collision" name="pick_obstacle_post_0_collision"
          type="cylinder" size="0.020 0.110"/>
    <geom class="prop_visual" name="pick_obstacle_post_0_post"
          type="cylinder" size="0.020 0.110" rgba="0.02 0.02 0.02 1"/>
  </body>

  <body name="pick_obstacle_fence_0" mocap="true" pos="13 8 2.070">
    <inertial pos="0 0 0" mass="0.1" diaginertia="1e-4 1e-4 1e-4"/>
    <geom class="prop_collision" name="pick_obstacle_fence_0_collision_bar"
          type="capsule" size="0.008 0.090" zaxis="1 0 0"/>
    <geom class="prop_visual" name="pick_obstacle_fence_0_bar"
          type="capsule" size="0.008 0.090" zaxis="1 0 0" rgba="0.02 0.02 0.02 1"/>
