    <geom class="prop_visual" name="pick_obstacle_divider_0_frame_left"
          type="box" size="0.006 0.012 0.040" pos="-0.098 0 0.040"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_divider_0_frame_right"
          type="box" size="0.006 0.012 0.040" pos="0.098 0 0.040"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_divider_0_rail_top"
