    <geom class="prop_visual" name="pick_obstacle_bollard_1_band_low"
          type="cylinder" size="0.026 0.014" pos="0 0 0.080"
          rgba="0.02 0.02 0.02 1"/>
    <geom class="prop_visual" name="pick_obstacle_bollard_1_band_high"
          type="cylinder" size="0.026 0.014" pos="0 0 0.190"
